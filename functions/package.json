{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "test": "node --test --experimental-test-isolation=none corretor-auth.test.js",
    "test:rules:corretor": "firebase emulators:exec --config ../firebase.json --project demo-corretor-rules --only firestore \"node --test --test-concurrency=1 --experimental-test-isolation=none firestore.corretor.rules.test.js\"",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^10.6.2",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "eslint": "^8.15.0",
    "eslint-plugin-promise": "^6.0.0"
  },
  "private": true
}
